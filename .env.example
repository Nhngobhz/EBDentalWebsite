# Copy this file to .env and adjust as needed.

# "development" (default) or "production". Set it to production on the real
# deployment: that marks the session cookie HTTPS-only (Secure) and keeps
# `python app.py` from starting the Werkzeug interactive debugger. Leave it alone
# locally - a Secure cookie is never sent over http://127.0.0.1, so setting this
# on a dev machine makes logging in appear to silently fail.
APP_ENV=development

# Base URL of the store-api backend (see ../store-api). Used both to call the API and
# to resolve any image/file path store-api returns as a local-disk path (/static/...)
# rather than a full R2 URL.
STORE_API_BASE_URL=http://localhost:8000

# Google Sign-In: the OAuth 2.0 "Web application" client ID from Google Cloud Console.
# Leave empty to hide the "Continue with Google" button entirely. Set the SAME value in
# store-api's .env (it verifies the tokens this button produces), and list every origin
# this app is served from - e.g. http://localhost:5000 - under that credential's
# "Authorized JavaScript origins". The client secret is never used; don't put it here.
GOOGLE_CLIENT_ID=

# Signs Flask's session cookie. Unrelated to store-api's own SECRET_KEY (that one signs
# JWTs) - never reuse one for the other. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Shared secret Prometheus presents as `Authorization: Bearer <token>` when it scrapes
# GET /metrics; without it that URL 404s. Must be the SAME value as store-api's
# METRICS_TOKEN - Prometheus sends one token to both targets. Empty (the default)
# disables instrumentation altogether. deploy\monitoring.ps1 fills both files in for
# you on the server; see metrics.py for what is measured and why it is measured here
# rather than in store-api.
METRICS_TOKEN=
